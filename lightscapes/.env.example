# Copy to .env and fill in.

# The Zigbee adapter, by its stable path: ls -l /dev/serial/by-id/
ZIGBEE_ADAPTER=/dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_0123456789-if00-port0

# Asked for by the Lightscapes page (any user name). Leave empty for none.
LIGHTSCAPES_PASSWORD=

# The address the Zigbee2MQTT and Lightscapes pages listen on. 0.0.0.0 is every network, including the venue's Wi-Fi;
# this computer's Tailscale address (tailscale ip -4) keeps them to your tailnet.
BIND_ADDRESS=0.0.0.0

TZ=Europe/Amsterdam
